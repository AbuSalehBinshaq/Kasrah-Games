generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  username      String         @unique
  password      String
  name          String?
  avatar        String?
  role          Role           @default(USER)
  isVerified    Boolean        @default(false)
  bio           String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastLoginAt   DateTime?
  resetPasswordToken       String?   @unique
  resetPasswordTokenExpiry DateTime?
  emailVerificationToken   String?   @unique
  emailVerificationExpiry  DateTime?
  otpCode                  String?
  otpExpiry                DateTime?
  
  ratings       Rating[]
  playSessions  PlaySession[]
  bookmarks     Bookmark[]
  
  @@map("users")
}

enum Role {
  USER
  ADMIN
}

model Game {
  id            String         @id @default(cuid())
  gameId        String         @unique @default(cuid())  // Game ID فريد للـ SDK
  slug          String         @unique
  title         String
  description   String
  shortDescription String
  developer     String
  publisher     String?
  releaseDate   DateTime?
  thumbnail     String
  coverImage    String?
  gameUrl       String
  gameType      GameType       @default(HTML5)
  technologies  String[]
  tags          String[]       @default([])
  requirements  Json?
  ageRating     String?
  isFeatured    Boolean        @default(false)
  isPublished   Boolean        @default(true)
  views         Int            @default(0)
  playCount     Int            @default(0)
  totalRevenue  Float          @default(0)  // إجمالي الأرباح
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  categories    GameCategory[]
  ratings       Rating[]
  playSessions  PlaySession[]
  bookmarks     Bookmark[]
  sdkAds        SDKAd[]
  sdkImpressions SDKAdImpression[]
  sdkEvents     SDKAnalyticsEvent[]
  sdkSessions   SDKSession[]
  sdkErrors     SDKError[]
  sdkConfig     SDKConfig?
  
  @@map("games")
}

enum GameType {
  HTML5
  WebGL
  Unity
  Flash
  Other
}

model Category {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  description   String?
  icon          String?
  color         String?
  order         Int            @default(0)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  games         GameCategory[]
  
  @@map("categories")
}

model GameCategory {
  id         String   @id @default(cuid())
  gameId     String
  categoryId String
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@unique([gameId, categoryId])
  @@map("game_categories")
}

model Rating {
  id          String   @id @default(cuid())
  isLike      Boolean  // true = like, false = dislike
  userId      String
  gameId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  
  @@unique([userId, gameId])
  @@map("ratings")
}

model PlaySession {
  id          String   @id @default(cuid())
  userId      String
  gameId      String
  duration    Int      // in seconds
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  
  @@index([gameId, startedAt, endedAt])
  @@index([startedAt])
  @@map("play_sessions")
}

model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  gameId      String
  folder      String?  @default("favorites")
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  
  @@unique([userId, gameId, folder])
  @@map("bookmarks")
}

model Settings {
  id                      String   @id @default("site-settings")
  siteName                String   @default("Kasrah Games")
  siteDescription         String   @default("العب أفضل ألعاب المتصفح مجاناً على كسرة جيمز - Play the best free browser games on Kasrah Games")
  siteLogo                String?
  siteFavicon             String?
  siteUrl                 String?
  contactEmail            String?
  socialFacebook          String?
  socialTwitter           String?
  socialInstagram         String?
  socialYoutube           String?
  maintenanceMode         Boolean  @default(false)
  maintenanceMessage      String?
  allowRegistration       Boolean  @default(true)
  requireEmailVerification Boolean @default(false)
  gamesPerPage            Int      @default(12)
  enableRatings           Boolean  @default(true)
  enableComments          Boolean  @default(true)
  enableBookmarks         Boolean  @default(true)
  showStatistics          Boolean  @default(true)
  primaryColor            String   @default("#7c3aed")
  primaryColorHover       String   @default("#6d28d9")
  backgroundFrom          String   @default("#f8fafc")
  backgroundTo            String   @default("#eef2ff")
  enableAnalytics         Boolean  @default(false)
  analyticsCode           String?
  seoMetaTitle            String?
  seoMetaDescription      String?
  seoMetaKeywords         String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  
  @@map("settings")
}

model Ad {
  id            String   @id @default(cuid())
  title         String
  type          AdType   @default(CUSTOM)
  position      AdPosition @default(SIDEBAR)
  size          AdSize   @default(MEDIUM)
  isActive      Boolean  @default(true)
  
  // For CUSTOM ads (image + link)
  imageUrl      String?
  clickUrl      String?
  
  // For CODE ads (custom JS/HTML)
  code          String?
  
  // Statistics
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  
  // Additional settings
  startDate     DateTime?
  endDate       DateTime?
  targetUrl     String?  // For tracking
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("ads")
}

enum AdType {
  CUSTOM  // Image + Link
  CODE    // Custom JS/HTML code
}

enum AdPosition {
  HEADER
  SIDEBAR
  FOOTER
  IN_CONTENT
  POPUP
}

enum AdSize {
  SMALL       // 300x100
  MEDIUM      // 300x250
  LARGE       // 728x90
  FULL_WIDTH  // 100% width
  CUSTOM      // Custom dimensions
}

model AuditLog {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  
  // Actor details
  actorId      String?
  actorEmail   String?
  actorRole    String?
  
  // Event details
  event        String   // e.g., AUTH_LOGIN_FAILURE, ADMIN_GAME_DELETE
  status       String   // SUCCESS or FAILURE
  
  // Resource details
  resource     String?  // e.g., Game, User, Ad
  resourceId   String?
  
  // Additional info
  details      Json?
  ipAddress    String?
  userAgent    String?
  
  @@index([timestamp])
  @@index([event])
  @@map("audit_logs")
}

// SDK Models
model SDKGameData {
  id          String   @id @default(cuid())
  userId      String
  gameId      String
  key         String
  value       Json
  size        Int      // Size in bytes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, gameId, key])
  @@index([userId, gameId])
  @@map("sdk_game_data")
}

model SDKAdImpression {
  id          String   @id @default(cuid())
  gameId      String
  adType      String   // video, rewarded, banner
  adId        String?
  userId      String?
  duration    Int?     // Duration in seconds
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  @@index([gameId, createdAt])
  @@index([userId])
  @@map("sdk_ad_impressions")
}

model SDKAnalyticsEvent {
  id          String   @id @default(cuid())
  gameId      String
  sessionId   String
  eventName   String
  eventData   Json?
  userId      String?
  timestamp   DateTime @default(now())
  
  @@index([gameId, timestamp])
  @@index([sessionId])
  @@index([userId])
  @@map("sdk_analytics_events")
}

model SDKSession {
  id          String   @id @default(cuid())
  gameId      String
  userId      String?
  sessionId   String   @unique
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  duration    Int?     // Duration in seconds
  adCount     Int      @default(0)
  adRevenue   Float    @default(0)
  events      Int      @default(0)
  
  @@index([gameId, startedAt])
  @@index([userId])
  @@map("sdk_sessions")
}

model SDKError {
  id          String   @id @default(cuid())
  gameId      String
  sessionId   String?
  errorType   String
  errorMessage String
  stackTrace  String?
  userId      String?
  timestamp   DateTime @default(now())
  
  @@index([gameId, timestamp])
  @@index([errorType])
  @@map("sdk_errors")
}

model SDKConfig {
  id          String   @id @default(cuid())
  gameId      String   @unique
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  apiKey      String   @unique
  isActive    Boolean  @default(true)
  adFrequency Int      @default(3)
  autoPlayDelay Int    @default(5000)
  maxDataSize Int      @default(2097152)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("sdk_configs")
}

// نموذج الإعلانات المتقدم للـ SDK
model SDKAd {
  id            String   @id @default(cuid())
  gameId        String
  game          Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  adType        String   // video, rewarded, banner, interstitial
  title         String
  description   String?
  imageUrl      String?
  videoUrl      String?
  clickUrl      String?
  cpm           Float    @default(0)  // Cost Per Mille
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  revenue       Float    @default(0)
  isActive      Boolean  @default(true)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([gameId, isActive])
  @@map("sdk_ads")
}

// نموذج إحصائيات اللعبة اليومية
model SDKGameStats {
  id            String   @id @default(cuid())
  gameId        String
  date          DateTime
  totalPlays    Int      @default(0)
  totalUsers    Int      @default(0)
  totalSessions Int      @default(0)
  totalAdImpressions Int @default(0)
  totalAdClicks Int      @default(0)
  totalRevenue  Float    @default(0)
  avgSessionDuration Int @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([gameId, date])
  @@index([gameId, date])
  @@map("sdk_game_stats")
}

// نموذج الإحصائيات الشاملة
model SDKPlatformStats {
  id            String   @id @default("platform-stats")
  totalGames    Int      @default(0)
  totalUsers    Int      @default(0)
  totalPlays    Int      @default(0)
  totalRevenue  Float    @default(0)
  totalAdImpressions Int @default(0)
  totalAdClicks Int      @default(0)
  avgCTR        Float    @default(0)  // Click Through Rate
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@map("sdk_platform_stats")
}
