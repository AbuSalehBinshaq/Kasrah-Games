{
  "sdk": {
    "version": "3.0.0",
    "name": "Kasrah Games SDK",
    "description": "Professional Game Integration SDK for Kasrah Games Platform",
    "author": "Kasrah Games Team",
    "license": "MIT",
    "repository": "https://github.com/AbuSalehBinshaq/kasrah-games",
    "documentation": {
      "ar": "/sdk/README_AR.md",
      "en": "/sdk/README.md",
      "example": "/sdk/example.html"
    }
  },
  "api": {
    "baseUrl": "https://kasrah-games.onrender.com/api/sdk",
    "timeout": 10000,
    "endpoints": {
      "ads": {
        "get": "/ads/get",
        "track": "/ads/track"
      },
      "data": {
        "save": "/data/save",
        "load": "/data/load"
      },
      "analytics": {
        "track": "/analytics/track"
      }
    }
  },
  "features": {
    "ads": {
      "enabled": true,
      "types": ["video", "rewarded", "banner"],
      "frequency": 3,
      "autoPlayDelay": 5000
    },
    "dataStorage": {
      "enabled": true,
      "maxSize": 2097152,
      "cloudSync": true
    },
    "userAccounts": {
      "enabled": true,
      "authentication": "jwt"
    },
    "analytics": {
      "enabled": true,
      "autoTrack": true,
      "batchSize": 10
    },
    "errorHandling": {
      "enabled": true,
      "debugMode": false
    }
  },
  "defaults": {
    "gameId": null,
    "apiUrl": "https://kasrah-games.onrender.com/api/sdk",
    "debugMode": false,
    "enableAnalytics": true,
    "adFrequency": 3,
    "autoPlayDelay": 5000,
    "timeout": 10000
  },
  "events": {
    "system": [
      "initialized",
      "initError"
    ],
    "ads": [
      "adStarted",
      "adFinished",
      "adError"
    ],
    "data": [
      "dataSaved",
      "dataError"
    ],
    "user": [
      "userSet",
      "userCleared"
    ]
  },
  "errorCodes": {
    "INIT_ERROR": "SDK initialization failed",
    "GAME_ID_REQUIRED": "gameId is required",
    "AD_NOT_AVAILABLE": "No ads available",
    "DATA_SIZE_EXCEEDED": "Data exceeds maximum size",
    "NETWORK_ERROR": "Network request failed",
    "INVALID_USER": "Invalid user data",
    "API_ERROR": "API request failed"
  },
  "limits": {
    "maxDataSize": 2097152,
    "maxEventBatchSize": 100,
    "maxEventsPerSession": 10000,
    "sessionTimeout": 3600000,
    "requestTimeout": 10000
  },
  "compatibility": {
    "browsers": [
      "Chrome 60+",
      "Firefox 55+",
      "Safari 11+",
      "Edge 79+",
      "Opera 47+"
    ],
    "javascript": "ES6+",
    "minJSVersion": "ES6"
  }
}
